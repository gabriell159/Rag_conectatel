{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnviarLogChamadosRaw",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::conectatel-squad1-2026/conectatel/raw/log_chamados/*"
    },
    {
      "Sid": "EnviarCorpusRaw",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::conectatel-squad1-2026/conectatel/raw/corpus/*"
    },
    {
      "Sid": "EnviarLogChamadosProcessado",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::conectatel-squad1-2026/conectatel/processed/log_chamados/*"
    }
  ]
}